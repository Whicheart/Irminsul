<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.genshin.lunar.mapper.BannerMapper">

    <!-- 万能查询 -->
    <select id="getAllBanners" resultType="com.genshin.lunar.entity.Banner">
        SELECT * FROM banner
        ORDER BY version DESC
    </select>

</mapper>